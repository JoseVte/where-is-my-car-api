# Copy to .env (git ignored) and fill in the values.
# Read by Spring Boot (spring.config.import) and by `docker compose`.

APP_DEBUG=false
APP_SEED_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Registrations per client IP and period (ISO 8601 duration)
REGISTER_RATE_LIMIT_CAPACITY=5
REGISTER_RATE_LIMIT_PERIOD=PT1H

DB_NAME=whereismycar
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

FIREBASE_PROJECT_ID=
# Web API key of the Firebase project
FIREBASE_API_KEY=
# Service account key. Inside Docker the file is mounted automatically, this is for running from the IDE.
FIREBASE_CREDENTIALS_PATH=file:./firebase-credentials.json

# Development seeder (./seed.sh)
SEED_EMAIL=
SEED_PASSWORD=
