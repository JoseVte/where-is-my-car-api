# Production .env, in the Forge site directory (never in git). The daemon exports it.

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Trust X-Forwarded-For from Nginx (real client IP for the registration rate limit)
SERVER_FORWARD_HEADERS_STRATEGY=native
SPRING_DOCKER_COMPOSE_ENABLED=false

# Forge database (Server, Database)
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/whereismycar
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DB_NAME=whereismycar
DB_USERNAME=
DB_PASSWORD=

FIREBASE_PROJECT_ID=where-is-my-car-486413
# Server key, restricted to the Identity Toolkit API
FIREBASE_API_KEY=
FIREBASE_CREDENTIALS_PATH=file:/home/forge/api-where-is-my-car.josrom.io/firebase-credentials.json

APP_CORS_ALLOWED_ORIGINS=https://where-is-my-car.josrom.io
APP_DEBUG=false
APP_SEED_ENABLED=false

# Small server: few threads and connections are enough for personal use
TOMCAT_MAX_THREADS=20
DB_POOL_SIZE=5
